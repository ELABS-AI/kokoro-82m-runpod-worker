{
  "description": "Kokoro 82M is a lightweight text-to-speech model (~82M parameters) supporting multiple voices and languages. API: POST JSON with {text, voice, speed} -> {audio_base64, text, voice, wall_time_s}. GPU: runs on any GPU with >=2GB VRAM (T4, L4, RTX 4090, etc.). Fast inference, minimal memory footprint.",
  "category": "audio",
  "type": "serverless",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 10,
    "gpuCount": 1,
    "gpuIds": "ADA_24,ADA_48,AMPERE_48,AMPERE_16,TURING_16",
    "allowedCudaVersions": [
      "12.8",
      "12.7",
      "12.6",
      "12.5",
      "12.4",
      "12.3",
      "12.2",
      "12.1",
      "12.0"
    ],
    "env": [
      {
        "key": "PYTORCH_CUDA_ALLOC_CONF",
        "value": "expandable_segments:True"
      }
    ],
    "presets": [
      {
        "name": "Fast (default voice)",
        "defaults": {
          "VOICE": "af_bella",
          "SPEED": "1.0"
        }
      },
      {
        "name": "Quality (slow, high-fidelity)",
        "defaults": {
          "VOICE": "af_bella",
          "SPEED": "0.8"
        }
      }
    ]
  },
  "title": "elabs / Kokoro 82M TTS",
  "iconUrl": "https://pub-796a08821c1c483aaf5e274e0d03e350.r2.dev/hub-icons/kokoro.svg"
}